#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D ycbcr_input;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D rgba_output;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
} pc;

void main() {
    if (gl_GlobalInvocationID.x >= pc.width || gl_GlobalInvocationID.y >= pc.height) {
        return;
    }
    vec2 uv = (vec2(gl_GlobalInvocationID.xy) + 0.5) / vec2(pc.width, pc.height);
    vec4 c = texture(ycbcr_input, uv);
    // Qualcomm Adreno YCbCr sampler outputs raw YCbCr planes:
    //   c.g = Y (luma), c.r = Cr (V), c.b = Cb (U)
    float y = c.g;
    float cb = c.b - 0.5;
    float cr = c.r - 0.5;
    // BT.709 YCbCr -> RGB
    float r = y + 1.5748 * cr;
    float g = y - 0.1873 * cb - 0.4681 * cr;
    float b = y + 1.8556 * cb;
    imageStore(rgba_output, ivec2(gl_GlobalInvocationID.xy), vec4(r, g, b, 1.0));
}
