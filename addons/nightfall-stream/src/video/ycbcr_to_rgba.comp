#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D ycbcr_input;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D rgba_output;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint color_range;  // 0 for limited, 1 for full
    uint color_matrix; // 0 for BT.601, 1 for BT.709, 2 for BT.2020
} pc;

void main() {
    if (gl_GlobalInvocationID.x >= pc.width || gl_GlobalInvocationID.y >= pc.height) {
        return;
    }
    vec2 uv = (vec2(gl_GlobalInvocationID.xy) + 0.5) / vec2(pc.width, pc.height);
    vec4 c = texture(ycbcr_input, uv);
    
    // Qualcomm Adreno YCbCr sampler outputs raw YCbCr planes:
    //   c.g = Y (luma), c.b = Cb (U), c.r = Cr (V)
    float y_raw = c.g;
    float cb_raw = c.b;
    float cr_raw = c.r;

    float y, cb, cr;
    if (pc.color_range == 0) { // Limited / Narrow range (standard for streaming)
        y = (y_raw - 16.0 / 255.0) * (255.0 / 219.0);
        cb = (cb_raw - 128.0 / 255.0) * (255.0 / 224.0);
        cr = (cr_raw - 128.0 / 255.0) * (255.0 / 224.0);
    } else { // Full range
        y = y_raw;
        cb = cb_raw - 128.0 / 255.0;
        cr = cr_raw - 128.0 / 255.0;
    }

    vec3 rgb = vec3(0.0);
    if (pc.color_matrix == 1) { // BT.709 (standard for HD video)
        rgb.r = y + 1.5748 * cr;
        rgb.g = y - 0.1873 * cb - 0.4681 * cr;
        rgb.b = y + 1.8556 * cb;
    } else if (pc.color_matrix == 2) { // BT.2020 (HDR)
        rgb.r = y + 1.4746 * cr;
        rgb.g = y - 0.16455 * cb - 0.57135 * cr;
        rgb.b = y + 1.8814 * cb;
    } else { // BT.601 / Default (SD)
        rgb.r = y + 1.402 * cr;
        rgb.g = y - 0.344136 * cb - 0.714136 * cr;
        rgb.b = y + 1.772 * cb;
    }

    // Clamp output to [0.0, 1.0] to avoid out-of-range colors
    rgb = clamp(rgb, vec3(0.0), vec3(1.0));
    imageStore(rgba_output, ivec2(gl_GlobalInvocationID.xy), vec4(rgb, 1.0));
}
