+
+RDD::TextureID RenderingDeviceDriverVulkan::texture_create_from_android_hardware_buffer(void *p_buffer, DataFormat p_format, uint32_t p_width, uint32_t p_height, BitField<TextureUsageBits> p_usage) {
+	AHardwareBuffer *hb = (AHardwareBuffer *)p_buffer;
+
+	VkAndroidHardwareBufferFormatPropertiesANDROID format_props = {};
+	format_props.sType = VK_STRUCTURE_TYPE_ANDROID_HARDWARE_BUFFER_FORMAT_PROPERTIES_ANDROID;
+
+	VkAndroidHardwareBufferPropertiesANDROID props = {};
+	props.sType = VK_STRUCTURE_TYPE_ANDROID_HARDWARE_BUFFER_PROPERTIES_ANDROID;
+	props.pNext = &format_props;
+
+	VkResult err = vkGetAndroidHardwareBufferPropertiesANDROID(vk_device, hb, &props);
+	ERR_FAIL_COND_V_MSG(err, TextureID(), vformat("vkGetAndroidHardwareBufferPropertiesANDROID failed: %d", err));
+
+	// Create YCbCr conversion for NV12 hardware decode output.
+	// This enables Vulkan to convert YCbCr → RGB directly during sampling.
+	VkSamplerYcbcrConversionCreateInfo ycbcr_info = {};
+	ycbcr_info.sType = VK_STRUCTURE_TYPE_SAMPLER_YCBCR_CONVERSION_CREATE_INFO;
+	ycbcr_info.format = VK_FORMAT_UNDEFINED; // External format
+	ycbcr_info.ycbcrModel = VK_SAMPLER_YCBCR_MODEL_CONVERSION_YCBCR_709;
+	ycbcr_info.ycbcrRange = VK_SAMPLER_YCBCR_RANGE_ITU_NARROW;
+	ycbcr_info.components = { VK_COMPONENT_SWIZZLE_IDENTITY, VK_COMPONENT_SWIZZLE_IDENTITY, VK_COMPONENT_SWIZZLE_IDENTITY, VK_COMPONENT_SWIZZLE_IDENTITY };
+	ycbcr_info.xChromaOffset = VK_CHROMA_LOCATION_COSITED_EVEN;
+	ycbcr_info.yChromaOffset = VK_CHROMA_LOCATION_COSITED_EVEN;
+	ycbcr_info.chromaFilter = VK_FILTER_LINEAR;
+	ycbcr_info.forceExplicitReconstruction = VK_FALSE;
+
+	VkSamplerYcbcrConversion ycbcr_conversion = VK_NULL_HANDLE;
+	err = vkCreateSamplerYcbcrConversion(vk_device, &ycbcr_info, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_SAMPLER_YCBCR_CONVERSION), &ycbcr_conversion);
+	ERR_FAIL_COND_V_MSG(err, TextureID(), vformat("vkCreateSamplerYcbcrConversion failed: %d", err));
+
+	VkExternalFormatANDROID external_format = {};
+	external_format.sType = VK_STRUCTURE_TYPE_EXTERNAL_FORMAT_ANDROID;
+	external_format.externalFormat = format_props.externalFormat;
+
+	VkExternalMemoryImageCreateInfo ext_mem_info = {};
+	ext_mem_info.sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO;
+	ext_mem_info.pNext = &external_format;
+	ext_mem_info.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_ANDROID_HARDWARE_BUFFER_BIT_ANDROID;
+
+	VkImageCreateInfo image_create_info = {};
+	image_create_info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+	image_create_info.pNext = &ext_mem_info;
+	image_create_info.imageType = VK_IMAGE_TYPE_2D;
+	image_create_info.format = VK_FORMAT_UNDEFINED; // Must be UNDEFINED when using externalFormat
+	image_create_info.extent.width = p_width;
+	image_create_info.extent.height = p_height;
+	image_create_info.extent.depth = 1;
+	image_create_info.mipLevels = 1;
+	image_create_info.arrayLayers = 1;
+	image_create_info.samples = VK_SAMPLE_COUNT_1_BIT;
+	image_create_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+	image_create_info.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+	image_create_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+	image_create_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+
+	VkImage vk_image = VK_NULL_HANDLE;
+	err = vkCreateImage(vk_device, &image_create_info, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_IMAGE), &vk_image);
+	if (err) {
+		vkDestroySamplerYcbcrConversion(vk_device, ycbcr_conversion, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_SAMPLER_YCBCR_CONVERSION));
+		ERR_FAIL_COND_V_MSG(err, TextureID(), vformat("vkCreateImage from AHardwareBuffer failed: %d", err));
+	}
+
+	// Import the AHB memory and bind to the image
+	{
+		VkMemoryRequirements mem_req;
+		vkGetImageMemoryRequirements(vk_device, vk_image, &mem_req);
+
+		VkImportAndroidHardwareBufferInfoANDROID import_info = {};
+		import_info.sType = VK_STRUCTURE_TYPE_IMPORT_ANDROID_HARDWARE_BUFFER_INFO_ANDROID;
+		import_info.buffer = hb;
+
+		VkMemoryAllocateInfo alloc_info = {};
+		alloc_info.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+		alloc_info.pNext = &import_info;
+		alloc_info.allocationSize = mem_req.size;
+
+		// Find a memory type that supports the image
+		VkPhysicalDeviceMemoryProperties mem_props;
+		vkGetPhysicalDeviceMemoryProperties(physical_device, &mem_props);
+		uint32_t mem_type_idx = UINT32_MAX;
+		for (uint32_t i = 0; i < mem_props.memoryTypeCount; i++) {
+			if ((mem_req.memoryTypeBits & (1u << i)) &&
+			    (mem_props.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT)) {
+				mem_type_idx = i;
+				break;
+			}
+		}
+		if (mem_type_idx == UINT32_MAX) {
+			vkDestroyImage(vk_device, vk_image, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_IMAGE));
+			vkDestroySamplerYcbcrConversion(vk_device, ycbcr_conversion, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_SAMPLER_YCBCR_CONVERSION));
+			ERR_FAIL_COND_V_MSG(true, TextureID(), "No suitable memory type for AHB import");
+		}
+		alloc_info.memoryTypeIndex = mem_type_idx;
+
+		VkDeviceMemory memory = VK_NULL_HANDLE;
+		err = vkAllocateMemory(vk_device, &alloc_info, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_DEVICE_MEMORY), &memory);
+		if (err) {
+			vkDestroyImage(vk_device, vk_image, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_IMAGE));
+			vkDestroySamplerYcbcrConversion(vk_device, ycbcr_conversion, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_SAMPLER_YCBCR_CONVERSION));
+			ERR_FAIL_COND_V_MSG(err, TextureID(), vformat("vkAllocateMemory for AHB failed: %d", err));
+		}
+
+		err = vkBindImageMemory(vk_device, vk_image, memory, 0);
+		if (err) {
+			vkFreeMemory(vk_device, memory, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_DEVICE_MEMORY));
+			vkDestroyImage(vk_device, vk_image, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_IMAGE));
+			vkDestroySamplerYcbcrConversion(vk_device, ycbcr_conversion, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_SAMPLER_YCBCR_CONVERSION));
+			ERR_FAIL_COND_V_MSG(err, TextureID(), vformat("vkBindImageMemory for AHB failed: %d", err));
+		}
+
+		// Memory will be freed when the VkDevice is destroyed.
+	}
+
+	// Create image view with VK_FORMAT_UNDEFINED to match the external format image.
+	// texture_create_from_extension would use the passed p_format which doesn't match.
+	VkImageViewCreateInfo view_ci = {};
+	view_ci.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+	view_ci.image = vk_image;
+	view_ci.viewType = VK_IMAGE_VIEW_TYPE_2D;
+	view_ci.format = VK_FORMAT_UNDEFINED;
+	view_ci.components = { VK_COMPONENT_SWIZZLE_IDENTITY, VK_COMPONENT_SWIZZLE_IDENTITY, VK_COMPONENT_SWIZZLE_IDENTITY, VK_COMPONENT_SWIZZLE_IDENTITY };
+	view_ci.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+	view_ci.subresourceRange.levelCount = 1;
+	view_ci.subresourceRange.layerCount = 1;
+
+	VkImageView vk_view = VK_NULL_HANDLE;
+	err = vkCreateImageView(vk_device, &view_ci, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_IMAGE_VIEW), &vk_view);
+	if (err) {
+		vkDestroySamplerYcbcrConversion(vk_device, ycbcr_conversion, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_SAMPLER_YCBCR_CONVERSION));
+		vkDestroyImage(vk_device, vk_image, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_IMAGE));
+		ERR_FAIL_COND_V_MSG(err, TextureID(), vformat("vkCreateImageView for AHB failed: %d", err));
+	}
+
+	TextureInfo *tex_info = VersatileResource::allocate<TextureInfo>(resources_allocator);
+	tex_info->vk_image = vk_image;
+	tex_info->vk_view = vk_view;
+	tex_info->rd_format = p_format;
+	tex_info->vk_create_info = image_create_info;
+	tex_info->vk_view_create_info = view_ci;
+	tex_info->is_ycbcr = true;
+	tex_info->ycbcr_conversion = ycbcr_conversion;
+#ifdef DEBUG_ENABLED
+	tex_info->created_from_extension = true;
+#endif
+	return TextureID(tex_info);
+}
+#endif
