+#ifdef ANDROID_ENABLED
+RID RenderingDevice::texture_create_from_android_hardware_buffer(uint64_t p_buffer, DataFormat p_format, uint32_t p_width, uint32_t p_height, BitField<TextureUsageBits> p_usage) {
+	Texture texture;
+	texture.type = TEXTURE_TYPE_2D;
+	texture.format = p_format;
+	texture.samples = TEXTURE_SAMPLES_1;
+	texture.width = p_width;
+	texture.height = p_height;
+	texture.depth = 1;
+	texture.layers = 1;
+	texture.mipmaps = 1;
+	texture.usage_flags = p_usage;
+	texture.base_mipmap = 0;
+	texture.base_layer = 0;
+	texture.allowed_shared_formats.push_back(RD::DATA_FORMAT_R8G8B8A8_UNORM);
+	texture.allowed_shared_formats.push_back(RD::DATA_FORMAT_R8G8B8A8_SRGB);
+	texture.read_aspect_flags.set_flag(RDD::TEXTURE_ASPECT_COLOR_BIT);
+	texture.barrier_aspect_flags.set_flag(RDD::TEXTURE_ASPECT_COLOR_BIT);
+
+	void *buffer_ptr = (void *)p_buffer;
+	texture.driver_id = driver->texture_create_from_android_hardware_buffer(buffer_ptr, p_format, p_width, p_height, p_usage);
+	ERR_FAIL_COND_V(!texture.driver_id, RID());
+
+	_texture_make_mutable(&texture, RID());
+
+	RID id = texture_owner.make_rid(texture);
+#ifdef DEV_ENABLED
+	set_resource_name(id, "RID:" + itos(id.get_id()));
+#endif
+
+	return id;
+}
+#endif
 
